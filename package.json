{
  "name": "style-my-space-design",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "content:scrape": "tsx scripts/scrape.ts",
    "content:images": "tsx scripts/optimize-images.ts",
    "content:check": "tsx scripts/check-content.ts",
    "content": "pnpm content:scrape && pnpm content:images && pnpm content:check",
    "qa": "tsx scripts/qa.ts",
    "qa:sheets": "tsx scripts/contact-sheet.ts",
    "qa:lighthouse": "tsx scripts/lighthouse.ts",
    "qa:bundle": "tsx scripts/check-bundle.ts",
    "qa:webgl": "playwright test -c qa/playwright.config.ts",
    "qa:all": "pnpm build && tsx scripts/qa.ts --serve && tsx scripts/contact-sheet.ts && tsx scripts/lighthouse.ts --serve"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "0.185.4",
    "chrome-launcher": "1.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "lighthouse": "12.8.2",
    "playwright": "1.62.1",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.12",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.12.3"
}
